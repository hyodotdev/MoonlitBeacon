{
  "name": "moonlit-beacon",
  "version": "0.0.1",
  "private": true,
  "description": "Moonlit Beacon — Godot 4 first 2D game course monorepo",
  "license": "MIT",
  "repository": "github:hyodotdev/MoonlitBeacon",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs:dev": "pnpm --filter @moonlit-beacon/docs start",
    "docs:build": "pnpm --filter @moonlit-beacon/docs build",
    "docs:serve": "pnpm --filter @moonlit-beacon/docs serve",
    "docs:clear": "pnpm --filter @moonlit-beacon/docs clear",
    "godot": "node scripts/godot.mjs",
    "game": "node scripts/godot.mjs --path apps/game",
    "game:editor": "node scripts/godot.mjs -e --path apps/game",
    "game:check": "node scripts/godot.mjs --headless --path apps/game --quit",
    "android:build": "node scripts/android-build.mjs",
    "android:release": "node scripts/android-build.mjs --release",
    "android:bundle": "node scripts/android-build.mjs --bundle",
    "android:run": "node scripts/android.mjs adb install -r builds/android/MoonlitBeacon.apk && node scripts/android.mjs adb shell monkey -p com.crossplatformkorea.moonlitbeacon -c android.intent.category.LAUNCHER 1",
    "android:shot": "node scripts/android.mjs shot builds/shots/android.png",
    "emu": "node scripts/android.mjs emu",
    "emu:dev": "pnpm android:build && pnpm android:run",
    "ios:devices": "node scripts/ios.mjs devices",
    "ios:export": "node scripts/ios.mjs export",
    "ios:build": "node scripts/ios.mjs build",
    "ios:run": "node scripts/ios.mjs run",
    "ios:archive": "node scripts/ios.mjs archive",
    "ios:export-appstore": "node scripts/ios.mjs export-appstore",
    "ios:validate:dry-run": "node scripts/ios.mjs validate --dry-run",
    "ios:validate": "node scripts/ios.mjs validate",
    "ios:upload:dry-run": "node scripts/ios.mjs upload --dry-run",
    "ios:upload": "node scripts/ios.mjs upload --confirm-upload",
    "store:graphics": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py",
    "store:capture-screenshots": "node scripts/capture-store-screenshots.mjs",
    "store:capture-ios-device": "node scripts/capture-ios-device-evidence.mjs",
    "store:screenshots": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --screenshots",
    "store:screenshots:play": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --play-screenshots",
    "store:sync-play": "node scripts/sync-play-store-assets.mjs",
    "store:sync-app-store": "node scripts/sync-play-store-assets.mjs app-store",
    "play:images:check": "node scripts/apply-play-listing-images.mjs --check",
    "play:images:apply": "node scripts/apply-play-listing-images.mjs --apply",
    "store:screenshots:app-store": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --app-store-screenshots",
    "store:screenshots:app-store:android-pixel-avd": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --app-store-screenshots --app-store-iphone-source=android-pixel-avd",
    "check:store-screenshots": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --check-screenshots",
    "check:store-screenshots:play": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --check-play-screenshots",
    "check:store-screenshots:app-store": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --check-app-store-screenshots",
    "store:prepare-play": "node scripts/prepare-play-release.mjs",
    "app-store:release": "node scripts/app-store-release.mjs",
    "app-store:release:check": "node scripts/app-store-release.mjs --check",
    "app-store:release:remote-audit": "node scripts/app-store-release.mjs --check --remote-audit",
    "analytics:report": "node scripts/analyze-game-analytics.mjs",
    "store:contact": "node scripts/configure-store-contact.mjs",
    "test:game": "node --test apps/game/tools/godot_error_filter.test.mjs && node apps/game/tools/run_regression_tests.mjs",
    "test:android-build": "node --test scripts/lib/android-build.test.mjs scripts/lib/android-gradle-compat.test.mjs scripts/lib/android-release-signing.test.mjs scripts/lib/release-environment.test.mjs",
    "test:iapkit-config": "node --test scripts/lib/iapkit-config.test.mjs",
    "test:godot-iap-vendor": "node --test scripts/lib/godot-iap-vendor.test.mjs",
    "test:play-release-package": "node --test scripts/lib/play-release-package.test.mjs scripts/lib/capture-run-state.test.mjs scripts/lib/android-capture-persistence.test.mjs scripts/lib/android-capture-signing.test.mjs scripts/lib/android-tablet-evidence.test.mjs scripts/lib/ios-device-evidence.test.mjs scripts/lib/store-graphics-boundary.test.mjs",
    "test:ios-device-evidence": "node --test scripts/lib/ios-device-evidence.test.mjs",
    "test:export-preflight": "node --test scripts/lib/godot-export-preflight.test.mjs scripts/lib/export-resource-filter.test.mjs",
    "test:ios-build": "node --test scripts/lib/ios-build.test.mjs scripts/lib/ios-distribution.test.mjs",
    "test:app-store-release": "node --test scripts/lib/app-store-release.test.mjs scripts/lib/app-store-connect-apply.test.mjs",
    "test:store-contact": "node --test scripts/lib/store-contact-config.test.mjs",
    "test:store-metadata": "node --test scripts/lib/store-metadata.test.mjs",
    "test:analytics": "node --test scripts/lib/game-analytics.test.mjs",
    "test:firestore-index": "node --test scripts/lib/firestore-index.test.mjs",
    "verify": "pnpm test:android-build && pnpm test:iapkit-config && pnpm test:godot-iap-vendor && pnpm test:play-release-package && pnpm test:export-preflight && pnpm test:ios-build && pnpm test:app-store-release && pnpm test:store-contact && pnpm test:store-metadata && pnpm test:analytics && pnpm test:firestore-index && pnpm test:game && pnpm game:check && pnpm check:scripts && pnpm check:locale && pnpm check:store-metadata && pnpm check:skills && pnpm check:hygiene && pnpm check:assets && pnpm check:store-graphics && pnpm docs:build && pnpm check:docs",
    "check:locale": "node .github/scripts/check-locale.mjs && node scripts/godot.mjs --headless --path apps/game --script res://tools/check_locale.gd",
    "check:store-metadata": "node scripts/check-store-metadata.mjs",
    "skills:sync": "node scripts/sync-agent-skills.mjs --write",
    "check:skills": "node --test scripts/lib/agent-skill-sync.test.mjs && node scripts/sync-agent-skills.mjs --check",
    "check:hygiene": "node .github/scripts/check-hygiene.mjs",
    "check:assets": "node --test scripts/lib/custom-asset-reference.test.mjs && node .github/scripts/check-manifest.mjs && node .github/scripts/check-media.mjs && node scripts/python.mjs -B apps/game/tools/check_custom_assets.py && node scripts/python.mjs -B apps/game/tools/build_app_icon_assets.py --check && node scripts/python.mjs -B apps/game/tools/build_warden_assets.py --check && node scripts/python.mjs -B apps/game/tools/build_companion_hero_assets.py --check && node scripts/python.mjs -B apps/game/tools/build_spirit_guardian_assets.py --check && node scripts/python.mjs -B apps/game/tools/pack_grok_spirits.py --check && node scripts/python.mjs -B apps/game/tools/pack_ludo_guardians.py --check && node scripts/python.mjs -B apps/game/tools/build_moon_slash_asset.py --check && node scripts/python.mjs -B apps/game/tools/build_terrain_obstacles.py --check && node scripts/python.mjs -B apps/game/tools/build_missile_core_asset.py --check && node scripts/python.mjs -B apps/game/tools/build_custom_ui_panels.py --check && node scripts/python.mjs -B apps/game/tools/build_world_assets.py --check && node scripts/python.mjs -B apps/game/tools/build_gate_projectile_assets.py --check",
    "check:store-graphics": "node scripts/python.mjs -B apps/game/tools/build_store_graphics.py --check",
    "check:docs": "node scripts/strip-nul.mjs --check apps/docs/build && node .github/scripts/check-anchors.mjs",
    "check:scripts": "node scripts/godot.mjs --headless --path apps/game res://tools/check_scripts.tscn",
    "growth:report": "node scripts/growth-report.mjs",
    "growth:check": "node scripts/growth-report.mjs --check",
    "test:growth": "node --test scripts/lib/growth-report.test.mjs"
  },
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
