diff --git a/apps/game/addons/godot-iap/godot_iap.gd b/apps/game/addons/godot-iap/godot_iap.gd
index 6c63de9..521e5d4 100644
--- a/apps/game/addons/godot-iap/godot_iap.gd
+++ b/apps/game/addons/godot-iap/godot_iap.gd
@@ -73,7 +73,9 @@ var _apple_async_terminal_keys: Dictionary = {}
 var _apple_async_terminal_order: Array[String] = []
 var _apple_async_cancellation_generation := 0
 var _apple_async_timeout_seconds := 30.0
-var _apple_async_restore_timeout_seconds := 120.0
+# Moonlit: AppStore.sync() can show Face ID or sign-in sheets that outlast
+# 120 s, so an explicit restore waits up to 10 minutes.
+var _apple_async_restore_timeout_seconds := 600.0
 var _apple_async_ui_timeout_seconds := 300.0
 
 # Platform detection
diff --git a/apps/game/addons/godot-iap/godot_iap_plugin.gd b/apps/game/addons/godot-iap/godot_iap_plugin.gd
index f6bae9e..9e06100 100644
--- a/apps/game/addons/godot-iap/godot_iap_plugin.gd
+++ b/apps/game/addons/godot-iap/godot_iap_plugin.gd
@@ -40,6 +40,10 @@ class GodotIapExportPlugin extends EditorExportPlugin:
 		"res://addons/godot-iap/bin/ios/GodotIap.framework",
 		"res://addons/godot-iap/bin/ios/SwiftGodotRuntime.framework",
 	]
+	const IOS_GDEXTENSION_SOURCE = \
+		"res://addons/godot-iap/bin/godot_iap.gdextension.ios"
+	const IOS_GDEXTENSION_EXPORT = \
+		"res://addons/godot-iap/bin/godot_iap.gdextension"
 
 	func _get_name() -> String:
 		return PLUGIN_NAME
@@ -59,6 +63,22 @@ class GodotIapExportPlugin extends EditorExportPlugin:
 		if not _is_ios_export(features):
 			return
 
+		# Moonlit keeps the iOS-only descriptor as .gdextension.ios so desktop
+		# Godot 4.7 logs no errors; the PCK still gets it under the live name.
+		if FileAccess.file_exists(IOS_GDEXTENSION_SOURCE):
+			add_file(
+				IOS_GDEXTENSION_EXPORT,
+				FileAccess.get_file_as_bytes(IOS_GDEXTENSION_SOURCE),
+				false)
+			add_file(
+				"res://.godot/extension_list.cfg",
+				(IOS_GDEXTENSION_EXPORT + "\n").to_utf8_buffer(),
+				false)
+		else:
+			push_warning(
+				"[GodotIap] Missing iOS GDExtension descriptor: %s"
+				% IOS_GDEXTENSION_SOURCE)
+
 		for framework_path in IOS_FRAMEWORKS:
 			if not DirAccess.dir_exists_absolute(framework_path):
 				push_warning("[GodotIap] Missing iOS framework: %s" % framework_path)
