@@ -77,8 +77,24 @@ copy_framework_plists
 # Backup original once per run.
 cp "$PBXPROJ" "$PBXPROJ.backup"
 
+# Homebrew framework Python under Node spawnSync can stall loading
+# extension modules on some macOS setups. The Xcode-bundled system
+# Python has the stdlib this script needs, so prefer it.
+PYTHON_BIN="${PYTHON_BIN:-}"
+if [ -z "$PYTHON_BIN" ]; then
+    if [ "$(uname -s)" = "Darwin" ] && [ -x /usr/bin/python3 ]; then
+        PYTHON_BIN=/usr/bin/python3
+    else
+        PYTHON_BIN="$(command -v python3 || true)"
+    fi
+fi
+if [ -z "$PYTHON_BIN" ] || [ ! -x "$PYTHON_BIN" ]; then
+    echo "Error: python3 is required to fix iOS framework embedding." >&2
+    exit 1
+fi
+
 export PBXPROJ IOS_EXPORT_DIR
