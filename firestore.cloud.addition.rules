// 4.0.0 owned-cloud rules addition. NOT a standalone ruleset: the director
// inserts this block inside `match /databases/{database}/documents {`,
// immediately before the final `match /{document=**}` catch-all in
// `firestore.rules`. Legacy `/scores` and `/analytics_events_v1` blocks stay
// byte-identical. See `tests/cloud-rules/build-combined-rules.mjs`.

function isSignedIn() {
  return request.auth != null;
}

function isValidPublicId(publicId) {
  return publicId is string && publicId.matches('^MB-[0-9a-f]{32}$');
}

function isNearNow(stamp) {
  return stamp is timestamp
    && stamp >= request.time - duration.value(15, 'm')
    && stamp <= request.time + duration.value(10, 'm');
}

function isAllowedHero(hero) {
  return hero in [
    'res://resources/heroes/warden.tres',
    'res://resources/heroes/dancer.tres',
    'res://resources/heroes/keeper.tres',
    'res://resources/heroes/knight.tres',
    'res://resources/heroes/eclipse.tres',
    'res://resources/heroes/sage.tres'
  ];
}

// Hall ownership needs BOTH halves of the pair: the caller's UID profile
// must map to this public ID, and the ID reservation itself must belong to
// the caller. A profile alone proves nothing, because a profile row only
// restates an ID string; the reservation is the claim. Public Hall rows
// still never carry a UID, email, or credential.
function ownsPublicId(publicId) {
  return isSignedIn()
    && exists(/databases/$(database)/documents/mb_profiles_v1/$(request.auth.uid))
    && get(/databases/$(database)/documents/mb_profiles_v1/$(request.auth.uid)).data.public_id == publicId
    && exists(/databases/$(database)/documents/mb_reservations_v1/$(publicId))
    && get(/databases/$(database)/documents/mb_reservations_v1/$(publicId)).data.uid == request.auth.uid;
}

// Post-commit twin of the reservation leg above. Registration commits the
// profile and the reservation atomically, so the profile rule must see the
// reservation as it stands AFTER the whole commit, not before it.
function reservationOwnedAfter(publicId) {
  return existsAfter(/databases/$(database)/documents/mb_reservations_v1/$(publicId))
    && getAfter(/databases/$(database)/documents/mb_reservations_v1/$(publicId)).data.uid == request.auth.uid;
}

// Mirror image: the reservation rule sees the profile after the commit, so
// neither half can be created without the other.
function profileMapsAfter(uid, publicId) {
  return existsAfter(/databases/$(database)/documents/mb_profiles_v1/$(uid))
    && getAfter(/databases/$(database)/documents/mb_profiles_v1/$(uid)).data.public_id == publicId;
}

// Hall ownership in the final state. Writes that also delete the pair must
// not leave a Hall row no living account owns.
function ownsPublicIdAfter(publicId) {
  return isSignedIn()
    && existsAfter(/databases/$(database)/documents/mb_profiles_v1/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/mb_profiles_v1/$(request.auth.uid)).data.public_id == publicId
    && existsAfter(/databases/$(database)/documents/mb_reservations_v1/$(publicId))
    && getAfter(/databases/$(database)/documents/mb_reservations_v1/$(publicId)).data.uid == request.auth.uid;
}

// Pair-half absence after the commit. Living halves go only together: each
// delete requires the counterpart gone too.
function reservationGoneAfter(publicId) {
  return !existsAfter(/databases/$(database)/documents/mb_reservations_v1/$(publicId));
}

function profileGoneAfter(uid) {
  return !existsAfter(/databases/$(database)/documents/mb_profiles_v1/$(uid));
}

// True once the public row is gone, in this commit or earlier. Reservation
// and profile deletes require it so a removed pair half can never orphan or
// re-home an existing Hall row.
function hallGoneAfter(publicId) {
  return !existsAfter(/databases/$(database)/documents/mb_hall_v1/$(publicId));
}

function adventurerGoneAfter(publicId) {
  return !existsAfter(/databases/$(database)/documents/mb_adventurers_v1/$(publicId));
}

function nameGoneAfter(nameKey) {
  return !existsAfter(/databases/$(database)/documents/mb_names_v1/$(nameKey));
}

function attendanceGoneAfter(publicId) {
  return !existsAfter(/databases/$(database)/documents/mb_attendance_v1/$(publicId));
}

function validProfile(uid, data) {
  return data.keys().hasOnly(
      ['uid', 'public_id', 'schema', 'created_at', 'updated_at'])
    && data.uid == uid
    && isValidPublicId(data.public_id)
    && data.schema == 1
    && isNearNow(data.created_at)
    && isNearNow(data.updated_at);
}

// One immutable UID-to-public-ID row per Firebase UID. Creation also
// requires the paired reservation to belong to the caller after the commit,
// so no profile can point at another player's reserved ID: neither alone,
// nor mismatched in a batch, nor smuggled past a same-batch reservation
// delete (getAfter reads the final state). Registration is an atomic pair
// or nothing; sequential half-registration is denied on both sides. Updates
// are denied outright: the mapping can never be reassigned. Only the owner
// reads it, and a living row goes only with the public row and the
// reservation half both gone.
match /mb_profiles_v1/{uid} {
  allow get: if isSignedIn() && request.auth.uid == uid;
  allow list: if false;
  allow create: if isSignedIn() && request.auth.uid == uid
    && validProfile(uid, request.resource.data)
    && reservationOwnedAfter(request.resource.data.public_id);
  allow update: if false;
  // Missing rows delete as a no-op so an interrupted deletion resumes
  // cleanly; a living row goes only with the public row already gone, its
  // reservation half gone too, and the attendance row gone, so no crash
  // can strand a profile claiming a freed ID or a cooldown.
  allow delete: if isSignedIn() && request.auth.uid == uid
    && (!exists(/databases/$(database)/documents/mb_profiles_v1/$(uid))
      || (hallGoneAfter(resource.data.public_id)
        && reservationGoneAfter(resource.data.public_id)
        && adventurerGoneAfter(resource.data.public_id)
        && attendanceGoneAfter(resource.data.public_id)));
}

function validReservation(publicId, data) {
  return data.keys().hasOnly(['public_id', 'uid', 'schema', 'created_at'])
    && data.public_id == publicId
    && isSignedIn() && data.uid == request.auth.uid
    && data.schema == 1
    && isNearNow(data.created_at);
}

// Public-ID reservation keyed by the ID itself. `create` fires only when the
// document is absent, so another UID's existing ID can neither be claimed
// (that write is an update) nor changed (updates are denied). Creation also
// requires the paired profile after the commit: lone reservations are
// denied, and registration is an atomic pair or nothing. A living row goes
// only with the public row already gone and its profile half gone too, so a
// freed ID can never be re-registered underneath a living Hall row or a
// stranded profile.
match /mb_reservations_v1/{publicId} {
  allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
  allow list: if false;
  allow create: if isSignedIn() && isValidPublicId(publicId)
    && validReservation(publicId, request.resource.data)
    && profileMapsAfter(request.auth.uid, publicId);
  allow update: if false;
  // Missing rows delete as a no-op so an interrupted deletion resumes
  // cleanly; living rows still need their owner with the public row, the
  // profile half, and the attendance row all gone.
  allow delete: if isSignedIn()
    && (!exists(/databases/$(database)/documents/mb_reservations_v1/$(publicId))
      || (resource.data.uid == request.auth.uid
        && hallGoneAfter(publicId)
        && profileGoneAfter(resource.data.uid)
        && adventurerGoneAfter(publicId)
        && attendanceGoneAfter(publicId)));
}

function validCheckpointPayload(payload) {
  return payload is string && payload.size() > 0 && payload.size() <= 32768
    && payload.matches('\\{.*\\}');
}

function validCheckpoint(uid, data) {
  return data.keys().hasOnly(
      ['uid', 'revision', 'payload', 'schema', 'updated_at'])
    && data.uid == uid
    && data.revision is int && data.revision >= 1
    && validCheckpointPayload(data.payload)
    && data.schema == 1
    && isNearNow(data.updated_at);
}

// One private versioned checkpoint per UID. Revisions advance by exactly one,
// so stale or decreasing writes are denied; the client pairs this with a
// compare-and-swap update-time guard. The payload rule bounds only size and
// brace shape: it cannot parse JSON, so brace-shaped garbage still passes
// here and the client must reject non-JSON before upload and validate every
// download before applying it.
match /mb_checkpoints_v1/{uid} {
  allow get: if isSignedIn() && request.auth.uid == uid;
  allow list: if false;
  allow create: if isSignedIn() && request.auth.uid == uid
    && request.resource.data.revision == 1
    && validCheckpoint(uid, request.resource.data);
  allow update: if isSignedIn() && request.auth.uid == uid
    && request.resource.data.uid == resource.data.uid
    && request.resource.data.revision == resource.data.revision + 1
    && validCheckpoint(uid, request.resource.data);
  allow delete: if isSignedIn() && request.auth.uid == uid;
}

function validHall(publicId, data) {
  return data.keys().hasOnly(
      ['public_id', 'hero', 'score', 'cycles', 'release', 'schema',
        'updated_at', 'display'])
    && data.public_id == publicId
    && isAllowedHero(data.hero)
    && data.score is int && data.score >= 0 && data.score <= 2000000000
    && data.cycles is int && data.cycles >= 0 && data.cycles <= 99999
    && data.release is string && data.release.size() > 0
      && data.release.size() <= 32
    && data.schema == 1
    && isNearNow(data.updated_at)
    && hallDisplayBound(publicId, data);
}

// A Hall display is honest when absent (legacy and unnamed rows) or when
// it equals the owner's own claimed adventurer name. Anything else — an
// unclaimed, malformed, or another player's handle — is a forged display
// and the write is denied.
function hallDisplayBound(publicId, data) {
  return !('display' in data.keys())
    || (validDisplayName(data.display)
      && exists(/databases/$(database)/documents/mb_adventurers_v1/$(publicId))
      && get(/databases/$(database)/documents/mb_adventurers_v1/$(publicId)).data.display == data.display);
}

// Public best-score row per public ID. Reads are open; writes require the
// matching UID profile AND the matching reservation, both owned by the
// caller, before AND after the commit, so a write bundled with pair deletes
// cannot orphan a row no living account owns. Scores never decrease, so
// equal-score retries are idempotent and races resolve toward the higher
// score. No email, private save, UID, or credential may appear: the key
// list forbids it.
match /mb_hall_v1/{publicId} {
  allow get, list: if true;
  allow create: if isValidPublicId(publicId)
    && ownsPublicId(publicId)
    && ownsPublicIdAfter(publicId)
    && validHall(publicId, request.resource.data);
  allow update: if ownsPublicId(publicId)
    && ownsPublicIdAfter(publicId)
    && request.resource.data.public_id == resource.data.public_id
    && request.resource.data.score >= resource.data.score
    && validHall(publicId, request.resource.data);
  // Missing rows delete as a signed-in no-op so an interrupted deletion
  // resumes cleanly; living rows still need the full ownership pair.
  allow delete: if isSignedIn()
    && (!exists(/databases/$(database)/documents/mb_hall_v1/$(publicId))
      || ownsPublicId(publicId));
}

// Adventurer display allow-list, mirrored exactly by the client's
// normalizer: Latin letters, digits, underscore, precomposed Hangul
// syllables (U+AC00-U+D7A3), Hiragana (U+3041-U+3096), Katakana
// (U+30A1-U+30FA plus the prolonged mark U+30FC), CJK ideographs
// (U+4E00-U+9FFF), and single interior ASCII spaces. BMP-only, so
// size() counts the same 2-12 visible characters both sides enforce.
function validDisplayName(display) {
  return display is string && display.size() >= 2 && display.size() <= 12
    && display == display.trim()
    && display.matches('^[A-Za-z0-9_가-힣ぁ-ゖァ-ヺー一-鿿]+( [A-Za-z0-9_가-힣ぁ-ゖァ-ヺー一-鿿]+)*$');
}

function validAdventurer(publicId, data) {
  return data.keys().hasOnly(['public_id', 'uid', 'name_key', 'display',
      'intro_complete', 'schema', 'created_at', 'updated_at'])
    && data.public_id == publicId
    && isSignedIn() && data.uid == request.auth.uid
    && validDisplayName(data.display)
    && data.name_key == data.display.lower()
    && data.intro_complete is bool
    && data.schema == 1
    && isNearNow(data.created_at)
    && isNearNow(data.updated_at);
}

// The paired name claim after the commit: same key, same display, same
// owner. Neither half is created without the other.
function nameClaimedAfter(publicId, nameKey, display) {
  return existsAfter(/databases/$(database)/documents/mb_names_v1/$(nameKey))
    && getAfter(/databases/$(database)/documents/mb_names_v1/$(nameKey)).data.public_id == publicId
    && getAfter(/databases/$(database)/documents/mb_names_v1/$(nameKey)).data.display == display
    && getAfter(/databases/$(database)/documents/mb_names_v1/$(nameKey)).data.name_key == nameKey;
}

// Mirror image: the name rule sees the adventurer after the commit.
function adventurerOwnedAfter(publicId, nameKey, display) {
  return existsAfter(/databases/$(database)/documents/mb_adventurers_v1/$(publicId))
    && getAfter(/databases/$(database)/documents/mb_adventurers_v1/$(publicId)).data.uid == request.auth.uid
    && getAfter(/databases/$(database)/documents/mb_adventurers_v1/$(publicId)).data.public_id == publicId
    && getAfter(/databases/$(database)/documents/mb_adventurers_v1/$(publicId)).data.name_key == nameKey
    && getAfter(/databases/$(database)/documents/mb_adventurers_v1/$(publicId)).data.display == display;
}

// One private adventurer row per public ID: the owner proven by the
// canonical pair reads it — including an authoritative missing-row read,
// since this rule never touches `resource` — nobody lists it, and creation
// binds it to the canonical pair before and after the commit plus its name
// half. Names are immutable: only the tutorial bit moves, false to true.
// A living row goes only with the full account deletion: name half, public
// row, and both canonical halves gone together, so a live name is never
// released or stranded under a living account.
match /mb_adventurers_v1/{publicId} {
  allow get: if ownsPublicId(publicId);
  allow list: if false;
  allow create: if isSignedIn() && isValidPublicId(publicId)
    && ownsPublicId(publicId) && ownsPublicIdAfter(publicId)
    && validAdventurer(publicId, request.resource.data)
    && request.resource.data.intro_complete == false
    && nameClaimedAfter(publicId, request.resource.data.name_key,
      request.resource.data.display);
  allow update: if ownsPublicId(publicId) && ownsPublicIdAfter(publicId)
    && request.resource.data.public_id == resource.data.public_id
    && request.resource.data.uid == resource.data.uid
    && request.resource.data.name_key == resource.data.name_key
    && request.resource.data.display == resource.data.display
    && resource.data.intro_complete == false
    && request.resource.data.intro_complete == true
    && validAdventurer(publicId, request.resource.data);
  // Missing rows delete as a no-op so an interrupted deletion resumes
  // cleanly; a living row goes only with the full account deletion.
  allow delete: if isSignedIn()
    && (!exists(/databases/$(database)/documents/mb_adventurers_v1/$(publicId))
      || (resource.data.uid == request.auth.uid
        && nameGoneAfter(resource.data.name_key)
        && hallGoneAfter(publicId)
        && reservationGoneAfter(publicId)
        && profileGoneAfter(resource.data.uid)));
}

function validNameClaim(nameKey, data) {
  return data.keys().hasOnly(['name_key', 'display', 'public_id', 'schema',
      'created_at'])
    && data.name_key == nameKey
    && validDisplayName(data.display)
    && data.name_key == data.display.lower()
    && isValidPublicId(data.public_id)
    && data.schema == 1
    && isNearNow(data.created_at);
}

// Global name index: the already-public handle and public ID only — no
// UID, credential, or private metadata. Any signed-in player may read one
// known key to test a collision; listing is denied. `create` fires only
// when the key is absent, so two owners racing for one name yield exactly
// one winner and mixed-case Latin variants collide on one lowercased key.
// Creation binds the claim to the caller's canonical pair plus its
// adventurer half. A living claim goes only with the full account
// deletion — adventurer half, public row, and both canonical halves gone
// together — so a name is never freed under a living score or a living
// account.
match /mb_names_v1/{nameKey} {
  allow get: if isSignedIn();
  allow list: if false;
  allow create: if isSignedIn()
    && ownsPublicId(request.resource.data.public_id)
    && ownsPublicIdAfter(request.resource.data.public_id)
    && validNameClaim(nameKey, request.resource.data)
    && adventurerOwnedAfter(request.resource.data.public_id, nameKey,
      request.resource.data.display);
  allow update: if false;
  // Missing rows delete as a no-op so an interrupted deletion resumes
  // cleanly; a living claim goes only with the full account deletion.
  allow delete: if isSignedIn()
    && (!exists(/databases/$(database)/documents/mb_names_v1/$(nameKey))
      || (ownsPublicId(resource.data.public_id)
        && adventurerGoneAfter(resource.data.public_id)
        && hallGoneAfter(resource.data.public_id)
        && reservationGoneAfter(resource.data.public_id)
        && profileGoneAfter(request.auth.uid)));
}

// One private attendance row per public ID: the last claim's server
// timestamp plus the receiving install. The owner proven by the canonical
// pair reads it — including an authoritative missing-row read, since this
// rule never touches `resource` — nobody lists it. The claim stamp must
// equal the server write time, so client-forged times die here; updates
// additionally wait out the rolling twelve hours against server time.
// Every advance carries the overwritten row's stamp and install
// (`prev_*`, both or neither): the carried pair must equal the old row
// exactly, so no advance — even from another install — can erase the
// last recoverable receipt, and first claims carry none. Deleting a
// living row would reset the cooldown, so it goes only with both
// canonical halves in the full account deletion.
function validAttendance(publicId, data) {
  return data.keys().hasOnly(['public_id', 'uid', 'install_id',
      'last_claim_at', 'schema', 'prev_claim_at', 'prev_install_id'])
    && data.public_id == publicId
    && isSignedIn() && data.uid == request.auth.uid
    && data.install_id is string
    && data.install_id.size() >= 1 && data.install_id.size() <= 64
    && data.schema == 1
    && (!data.keys().hasAny(['prev_claim_at', 'prev_install_id'])
      || (data.keys().hasAll(['prev_claim_at', 'prev_install_id'])
        && data.prev_claim_at is timestamp
        && data.prev_install_id is string
        && data.prev_install_id.size() >= 1
        && data.prev_install_id.size() <= 64));
}

match /mb_attendance_v1/{publicId} {
  allow get: if ownsPublicId(publicId);
  allow list: if false;
  allow create: if isSignedIn()
    && ownsPublicId(publicId)
    && ownsPublicIdAfter(publicId)
    && validAttendance(publicId, request.resource.data)
    && request.resource.data.last_claim_at == request.time
    && !request.resource.data.keys().hasAny(['prev_claim_at',
      'prev_install_id']);
  allow update: if isSignedIn()
    && ownsPublicId(publicId)
    && ownsPublicIdAfter(publicId)
    && request.resource.data.public_id == resource.data.public_id
    && request.resource.data.uid == resource.data.uid
    && validAttendance(publicId, request.resource.data)
    && request.resource.data.last_claim_at == request.time
    && request.time - resource.data.last_claim_at
      >= duration.value(43200, 's')
    && request.resource.data.prev_claim_at
      == resource.data.last_claim_at
    && request.resource.data.prev_install_id
      == resource.data.install_id;
  // Missing rows delete as a no-op so an interrupted deletion resumes
  // cleanly; a living row goes only with the full account deletion,
  // never alone to reset its own cooldown.
  allow delete: if isSignedIn()
    && (!exists(/databases/$(database)/documents/mb_attendance_v1/$(publicId))
      || (resource.data.uid == request.auth.uid
        && reservationGoneAfter(publicId)
        && profileGoneAfter(resource.data.uid)));
}
