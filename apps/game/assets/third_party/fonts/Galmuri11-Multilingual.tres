[gd_resource type="FontVariation" load_steps=3 format=3]

; 본문 글꼴. 파일 이름은 예전 그대로 두어 씬 40여 개의 참조를 건드리지 않는다.
; 실제 얼굴은 넥슨 메이플스토리체 Light 이다 — 아트가 부드러운 셀 셰이딩으로
; 바뀌면서 픽셀 폰트(Galmuri11)가 겉돌았고, 그 폰트는 11의 배수에서만 또렷해서
; UI 가 쓰는 53 가지 크기에서 뭉개졌다. 아웃라인 폰트는 크기를 안 가린다.
;
; 폰트 파일 자체는 배포본 그대로다 (라이선스가 수정을 금지한다).
; CJK 폴백만 얹는다 — 일본어·중국어 글립은 메이플체에 없다.

[ext_resource type="FontFile" path="res://assets/third_party/fonts/MaplestoryLight.ttf" id="1_base"]
[ext_resource type="FontFile" path="res://assets/third_party/fonts/NotoSansCJKsc-Regular.otf" id="2_fallback"]

[resource]
base_font = ExtResource("1_base")
fallbacks = Array[Font]([ExtResource("2_fallback")])
