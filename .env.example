# Moonlit Beacon — environment variable template
#
#     cp .env.example .env && chmod 600 .env
#
# `.env` is gitignored. **This file is not** — it is the committed template.
# So this file lists only names and "where to get them". Real values would
# go into the repo, and git history keeps them even after you delete the file.
#
# `scripts/lib/load-env.mjs` reads `.env` from 14 entry scripts.
# Priority is  real environment variables > .env > Keychain / default-path fallback.
#
# If the values are already in Keychain you do not have to fill this in.
# You can create `.env` with the procedure below — values never appear on
# screen or in shell history.
#
#     ./scripts/secrets-materialize.sh
#
# ─────────────────────────────────────────────────────────────────────────────
# Secrets you cannot rotate
# ─────────────────────────────────────────────────────────────────────────────
# Android upload key. Play treats the signing key as the app's identity.
# If it leaks, someone else can sign updates under this app's name; if it is
# lost, we cannot ship updates. Neither can be undone. Do not paste this
# line anywhere.
GODOT_ANDROID_KEYSTORE_RELEASE_PATH=
GODOT_ANDROID_KEYSTORE_RELEASE_USER=
GODOT_ANDROID_KEYSTORE_RELEASE_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Store credentials
# ─────────────────────────────────────────────────────────────────────────────
# App Store Connect. Create under Users and Access > Integrations > App Store Connect API.
# A `.p8` can be downloaded only once, at creation. Keep it outside the repo at mode 600.
MOONLIT_ASC_KEY_ID=
MOONLIT_ASC_ISSUER_ID=
MOONLIT_ASC_PRIVATE_KEY=
MOONLIT_ASC_APP_ID=

# Path to the Play Console service-account JSON. Create the key in Google Cloud
# Console and invite that account under Play Console > Users and permissions.
GOOGLE_APPLICATION_CREDENTIALS=

# ─────────────────────────────────────────────────────────────────────────────
# Service keys
# ─────────────────────────────────────────────────────────────────────────────
# IAPKit purchase verification. Only `openiap-kit_pk_…` goes in an app build.
# `openiap-kit_sk_…` (admin) never goes in a build — it is for dashboard work.
IAPKIT_API_KEY=
IAPKIT_ADMIN_KEY=

# ludo.ai — sprite and art generation.
LUDO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Not secrets — paths and public copy
# ─────────────────────────────────────────────────────────────────────────────
# scripts/ finds these if empty. Fill in only when several copies are installed
# and you want to pin one.
GODOT_BIN=
JAVA_HOME=
ANDROID_HOME=
ANDROID_SDK_ROOT=
MOONLIT_PYTHON=

# Values that go out on the store listing as-is.
MOONLIT_SUPPORT_EMAIL=
MOONLIT_PUBLIC_SITE_URL=
